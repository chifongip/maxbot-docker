[Unit]
Description=Maxbot navigation ROS container
Documentation=file:///home/ubuntu/docker_ws/maxbot-docker/DOCKER_ROS_AUTOSTART.md
Requires=docker.service pulseaudio.service
After=docker.service pulseaudio.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=process

# The host PulseAudio service owns this socket.  Retrying here covers the
# small interval between pulseaudio.service becoming active and its socket
# being ready for container clients.
ExecStartPre=/usr/bin/test -S /var/run/pulse/native
ExecStartPre=/usr/bin/docker container inspect maxbot-navigation
ExecStart=/usr/bin/docker start --attach maxbot-navigation
ExecStop=-/usr/bin/docker stop --time 30 maxbot-navigation

[Install]
WantedBy=multi-user.target
